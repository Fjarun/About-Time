# Allowlist — everything ignored by default, explicit un-ignores below
/*

# Public root files
!/README.md
!/.version
!/LICENSE
!/SECURITY.md
!/.gitignore
!/requirements.txt

# Public folders (directory AND contents both need un-ignoring)
!/Assets/
!/Assets/**
!/tests/
!/tests/**

# Re-ignore build noise inside an otherwise-public folder
tests/__pycache__/

# Source file patterns
!*.py

# Root exceptions: CLAUDE.md and .claude/ are not picked up when nested inside
# Internal/, so they stay at the project root and are ignored individually here.
CLAUDE.md
.claude/
